# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database — a learner's account data never belongs in the repo
/data/*.db
/data/*.db-wal
/data/*.db-shm

.vercel
.env*
# ...except the template, which is the documentation of what the others should
# contain. It holds names and comments, never a value.
!.env.example

# Local model weights for narration. ~340 MB of Kokoro, downloaded once by hand
# (see docs/video.md). The generated mp3s in public/narration ARE committed —
# the model that produced them is not.
/vendor/
