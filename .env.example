# Copy to .env.local and fill in what you need. Everything here is optional:
# the site runs, and every lesson and game works, with none of it set.
#
# Full explanation of each block: docs/accounts-signin-and-email.md

# ── Database ────────────────────────────────────────────────────────────────
# Unset locally: a SQLite file at ./data/market-academy.db is used instead, so a
# fresh clone needs no account and no network.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ── Where this site lives ───────────────────────────────────────────────────
# REQUIRED in production. Every OAuth redirect URI and every link inside an
# email is built from this — from configuration, never from the request's Host
# header, which an attacker can set. Falls back to the Vercel production domain,
# then to http://localhost:3000.
# SITE_URL=https://market-academy-three.vercel.app

# ── Signing in with a provider ──────────────────────────────────────────────
# A provider appears on the sign-in page only when BOTH of its variables are
# set, so these can be filled in one at a time with no code change.
#
# Register this redirect URI in each provider's console:
#   {SITE_URL}/api/auth/oauth/{provider}/callback
# and the localhost one too, or you cannot test locally.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Unset locally, messages are printed to the terminal with their links, which is
# a faster way to test the flows than a real inbox. Unset in production, sending
# is refused rather than silently pretended.
#
# EMAIL_FROM must be at a domain verified with the provider. A Gmail or Outlook
# address will be rejected.
# RESEND_API_KEY=
# EMAIL_FROM=Market Academy <hello@your-verified-domain.com>
# EMAIL_REPLY_TO=

# ── Payments ────────────────────────────────────────────────────────────────
# See docs/payments.md.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PAYWALL_ENABLED=false
